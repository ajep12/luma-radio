# ============================================================================
# Luma Radio — environment variables
# Copy this file to `.env` and fill in your real RadioCast details.
# When deploying to Cloudflare Pages, set the same variables under
# Project settings -> Environment variables (Production and Preview).
# ============================================================================

# --- RadioCast: REQUIRED ----------------------------------------------------
# The direct audio stream URL RadioCast gives you for your station.
# Example shape (yours will differ — copy it exactly from RadioCast): 
#   VITE_RADIOCAST_STREAM_URL=https://your-radiocast-domain/stream/luma-radio
VITE_RADIOCAST_STREAM_URL=

# --- RadioCast: OPTIONAL -----------------------------------------------------
# If RadioCast gives you a hosted embeddable player (iframe) instead of / in
# addition to a raw stream URL, put it here. Leave blank to use this site's
# own custom player against VITE_RADIOCAST_STREAM_URL.
VITE_RADIOCAST_PLAYER_EMBED_URL=

# If RadioCast exposes a "Now Playing" / metadata API for your station
# (current song, artist, artwork, presenter, listener count), put its URL
# here. Leave blank if you don't have one yet — the Now Playing UI will
# simply show your station identity instead of fabricated song data.
VITE_RADIOCAST_NOW_PLAYING_URL=

# Optional fallback audio to play if the live stream can't be reached.
VITE_RADIOCAST_FALLBACK_STREAM_URL=

# How often (in milliseconds) to poll the Now Playing endpoint above.
VITE_RADIOCAST_POLL_INTERVAL_MS=15000

# --- Station branding --------------------------------------------------------
VITE_STATION_NAME=Luma Radio
VITE_STATION_LOGO_URL=/logo.svg

# --- Future Supabase integration (not required to launch) -------------------
# Reserved for when accounts / requests / admin data are connected to
# Supabase. Safe to leave blank until then. See README.md "Future Supabase
# integration".
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
